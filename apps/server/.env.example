# ---------------------------------------------------------------------------
# Source 1 — Team projects organization (primary)   [REQUIRED]
# ---------------------------------------------------------------------------
# Organization (the {org} in https://dev.azure.com/{org})
AZDO_ORG=your-team-org
# Personal Access Token for that org. Scopes (read-only): Work Items (Read),
# Analytics (Read). SECURITY: keep this file out of version control.
AZDO_PAT=
# Optional: project to preselect in the UI filter (dashboards aggregate across
# ALL projects by default).
AZDO_PROJECT=
# Optional label shown in the UI.
AZDO_LABEL=Proyectos del equipo

# ---------------------------------------------------------------------------
# Source 2 — Keytia ticketing organization (optional)
# ---------------------------------------------------------------------------
# Independent Azure DevOps organization used for Keytia requirement/ticket
# tracking. Leave blank to disable the Keytia dashboard.
KEYTIA_ORG=
KEYTIA_PAT=
# Scope the Keytia dashboard to a single project (leave empty for org-wide).
KEYTIA_PROJECT=KeytiaDev Backlog
# Work item field used as "Cliente" (empty = derive from project name prefix).
KEYTIA_CLIENT_FIELD=Custom.Cliente
# Backlog types to count as "user stories" (comma-separated).
KEYTIA_STORY_TYPES=User Story
KEYTIA_LABEL=Keytia (tickets)

# ---------------------------------------------------------------------------
# Shared / server
# ---------------------------------------------------------------------------
AZDO_API_VERSION=7.1
PORT=4000
# Comma-separated list of origins allowed to call this proxy (the web app).
CORS_ORIGIN=http://localhost:5173
